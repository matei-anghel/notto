{
  "name": "notto",
  "productName": "Notto",
  "version": "0.1.0",
  "description": "Open-source AI notes, dictation and meeting assistant. Bring your own API keys or run models locally.",
  "main": "dist/main.js",
  "homepage": "https://usenotto.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/matei-anghel/notto.git"
  },
  "bugs": {
    "url": "https://github.com/matei-anghel/notto/issues"
  },
  "author": "Notto contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node build.config.js",
    "build:watch": "node build.config.js watch",
    "build:prod": "cross-env NODE_ENV=production node build.config.js",
    "build:mac-helper": "bash scripts/build-mac-helper.sh",
    "build:win-helper": "powershell -ExecutionPolicy Bypass -File scripts/build-win-helper.ps1",
    "rebuild:native": "node scripts/rebuild-native.js",
    "copy:native": "node scripts/copy-native-modules.js",
    "start": "npm run build && npm run rebuild:native && npm run copy:native && electron .",
    "start:dev": "npm run build:watch",
    "dist": "npm run build:prod && npm run rebuild:native && npm run copy:native && electron-builder",
    "dist:win": "npm run build:win-helper && npm run build:prod && npm run rebuild:native && npm run copy:native && electron-builder --win",
    "dist:mac": "npm run build:mac-helper && npm run build:prod && npm run rebuild:native && npm run copy:native && electron-builder --mac",
    "dist:linux": "npm run build:prod && npm run rebuild:native && npm run copy:native && electron-builder --linux",
    "pack": "npm run build:prod && npm run rebuild:native && npm run copy:native && electron-builder --dir",
    "test:unit": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.1.7",
    "fast-xml-parser": "^5.8.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "koffi": "^2.16.3",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "pdfjs-dist": "^6.3.289",
    "read-excel-file": "^8.0.3",
    "tiptap-markdown": "^0.9.0",
    "uiohook-napi": "^1.5.5",
    "win32-api": "^26.1.2",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "cross-env": "^7.0.3",
    "electron": "^43.8.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.6"
    },
    "diff": "^8.0.3",
    "tar": "^7.5.12"
  }
}
